<?xml version="1.0" encoding="utf-8"?>

<worksheet xml:id="practice-problems" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Practice Problems</title>

  <exercise xml:id="ex-limit-dne" workspace="3in">
    <statement>
      <p>
        Show that the following limit does not exist
        <md>
          \lim_{(x,y)\to(0,0)}\frac{3xy}{2x^4+5y^2}
        </md>.
      </p>
    </statement>
    <solution>
      <p>
        Let <m>f(x,y)=\frac{3xy}{2x^4+5y^2}</m>. Along <m>y=0</m>:
        <md>
          \lim_{x\to 0} f(x,0)=\lim_{x\to 0}\frac{0}{2x^4}=0
        </md>.
        Along <m>y=x</m>:
        <md>
          <mrow>\lim_{x\to 0} f(x,x) \amp = \lim_{x\to 0}\frac{3x^2}{2x^4+5x^2}</mrow>
          <mrow>\amp = \lim_{x\to 0}\frac{3}{2x^2+5}</mrow>
          <mrow>\amp = \frac{3}{5}</mrow>
        </md>.
        Since <m>0\neq\frac{3}{5}</m>, the limit does not exist.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-clairaut">
    <statement>
      <p>
        Let
        <md>
          f(x,y)=x\,e^{xy}+\frac{x}{1+y^2}
        </md>.
        Compute the mixed partial derivatives <m>f_{xy}</m> and <m>f_{yx}</m>,
        and verify that <m>f_{xy}=f_{yx}</m>, as guaranteed by Clairaut's
        theorem.
      </p>
    </statement>

    <solution>
      <p>
        First compute the first partial derivatives.
        Using the product rule and chain rule on the first term, and the
        quotient rule on the second term,
        <md>
          f_x(x,y)=(1+xy)\,e^{xy}+\frac{1}{1+y^2}
        </md>
        <md>
          f_y(x,y)=x^2e^{xy}-\frac{2xy}{(1+y^2)^2}
        </md>.
        Differentiating <m>f_x</m> with respect to <m>y</m> gives
        <md>
          <mrow>f_{xy}(x,y) \amp = x\,e^{xy}+(1+xy)\,x\,e^{xy}-\frac{2y}{(1+y^2)^2}</mrow>
          <mrow>\amp = x(2+xy)\,e^{xy}-\frac{2y}{(1+y^2)^2}</mrow>
        </md>.
        Differentiating <m>f_y</m> with respect to <m>x</m> gives
        <md>
          <mrow>f_{yx}(x,y) \amp = 2x\,e^{xy}+x^2y\,e^{xy}-\frac{2y}{(1+y^2)^2}</mrow>
          <mrow>\amp = x(2+xy)\,e^{xy}-\frac{2y}{(1+y^2)^2}</mrow>
        </md>.
        Therefore <m>f_{xy}=f_{yx}</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-contour-partials">
    <introduction>
      <p>
        A contour map of a function <m>f</m> is shown below, with the points
        <m>P</m> and <m>Q</m> marked.
      </p>
      <!-- FIGURE PLACEHOLDER: replace with an <image> (e.g., a <latex-image>) -->
      <p>
        <alert>[Figure placeholder]</alert> A contour map of a function
        <m>f(x,y)</m> (e.g., a hill whose peak is up and to the right), with
        level curves labeled by their values (e.g., <m>1,2,3,4,5</m>).
        Point <m>P</m> sits where the level curves increase to the right and are
        getting closer together; point <m>Q</m> sits where the values decrease
        as <m>y</m> increases.
      </p>

      <p>
        Determine whether each quantity is positive, negative, or zero.
        Explain your reasoning.
      </p>
    </introduction>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_x(P)</m>
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_y(P)</m>
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_{xx}(P)</m>
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_x(Q)</m>
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_y(Q)</m>
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          <m>f_{yy}(Q)</m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-tangent-plane-linearization">
    <introduction>
      <p>
        Let <m>f(x,y)=\sqrt{x^2+3y}</m>.
      </p>
    </introduction>

    <task workspace="1.5in">
      <statement>
        <p>
          Find the equation of the tangent plane to the graph <m>z=f(x,y)</m> at
          the point <m>(1,1)</m>.
        </p>
      </statement>
      <solution>
        <p>
          We have <m>f(1,1)=\sqrt{1+3}=2</m>. The partial derivatives are
          <md>
            <mrow>f_x(x,y) \amp = \frac{x}{\sqrt{x^2+3y}}</mrow>
            <mrow>f_y(x,y) \amp = \frac{3}{2\sqrt{x^2+3y}}</mrow>
          </md>,
          so <m>f_x(1,1)=\frac{1}{2}</m> and <m>f_y(1,1)=\frac{3}{4}</m>.
          A normal vector to the tangent plane is
          <md>
            \bvec{n}=\langle f_x(1,1),\,f_y(1,1),\,-1\rangle=\left\langle \tfrac{1}{2},\,\tfrac{3}{4},\,-1\right\rangle
          </md>,
          and the plane passes through the point <m>(1,1,2)</m>. So the tangent plane is
          <md>
            \tfrac{1}{2}(x-1)+\tfrac{3}{4}(y-1)-(z-2)=0
            </md>
        </p>
      </solution>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          Find the linearization <m>L(x,y)</m> of <m>f</m> at the point
          <m>(1,1)</m>.
        </p>
      </statement>
      <solution>
        <p>
          The linearization is the function whose graph is the tangent plane:
          <md>
            L(x,y)=2+\tfrac{1}{2}(x-1)+\tfrac{3}{4}(y-1)
          </md>.
        </p>
      </solution>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          Use your answer to part (b) to approximate <m>f(1.04,\,0.96)</m>. Then use a calculator to find the actual value, and compare.
        </p>
      </statement>
      <solution>
        <p>
          <md>
            <mrow>f(1.04,\,0.96) \approx L(1.04,\,0.96) \amp = 2+\tfrac{1}{2}(0.04)+\tfrac{3}{4}(-0.04)</mrow>
            <mrow>\amp = 2+0.02-0.03</mrow>
            <mrow>\amp = 1.99</mrow>
          </md>.
          The actual value is <m>f(1.04,\,0.96)=\sqrt{3.9616}\approx 1.9904</m>, so the approximation is off by only about <m>0.0004</m>.
        </p>
      </solution>
    </task>
  </exercise>

  <exercise xml:id="ex-hiking">
    <introduction>
      <p>
        You are hiking on a hill whose elevation (in meters) is
        <md>h(x,y)=1200-0.01x^2-0.02y^2</md> where <m>x</m> and <m>y</m> are
        measured in meters, the positive <m>x</m>-axis points east, and the
        positive <m>y</m>-axis points north.
        You are standing at the point <m>(60,20)</m>.
      </p>
    </introduction>

    <task workspace="1.5in">
      <statement>
        <p>
          If you walk northeast, are you ascending or descending?
          At what rate?
        </p>
      </statement>
      <solution>
        <p>
          The gradient is <md>\grad h(x,y)=\langle -0.02x,\,-0.04y\rangle</md>. So,
          <md>\grad h(60,20)=\langle -1.2,\,-0.8\rangle</md>.
          Northeast is the direction of the unit vector <m>\bvec{u}=\frac{1}{\sqrt{2}}\langle 1,1\rangle</m>, so
          <md>
            <mrow>D_{\bvec{u}}h(60,20) \amp = \langle -1.2,\,-0.8\rangle\cdot\tfrac{1}{\sqrt{2}}\langle 1,1\rangle</mrow>
            <mrow>\amp = -\tfrac{2}{\sqrt{2}} = -\sqrt{2}</mrow>
          </md>.
          Since this is negative, you are descending, at a rate of <m>\sqrt{2}\approx 1.41</m> meters of elevation per meter walked.
        </p>
      </solution>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          In what direction should you walk to climb most steeply? (You do not have to give compass directions; a vector is sufficient.)
          What is the slope in that direction?
        </p>
      </statement>
      <solution>
        <p>
          You climb most steeply in the direction of <m>\grad h(60,20)=\langle -1.2,\,-0.8\rangle</m> (roughly southwest, but more west than south). The slope in this direction is
          <md>
            |\grad h(60,20)|=\sqrt{(-1.2)^2+(-0.8)^2}=\sqrt{2.08}=\tfrac{2\sqrt{13}}{5}\approx 1.44
          </md>.
        </p>
      </solution>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          In what direction(s) should you walk to stay at the same elevation?
        </p>
      </statement>
      <solution>
        <p>
          To stay at the same elevation, walk in a direction <m>\bvec{u}</m> with <m>D_{\bvec{u}}h(60,20)=\grad h(60,20)\cdot\bvec{u}=0</m>, that is, perpendicular to <m>\langle -1.2,-0.8\rangle</m>.
          Two such vectors are
          <md>
            \bvec{v}=\langle 0.8,-1.2\rangle \quad\text{and}\quad \bvec{w}=\langle -0.8,1.2\rangle
          </md>.
        </p>
      </solution>
    </task>
  </exercise>

  <exercise xml:id="ex-contour-gradient">
    <introduction>
      <p>
        The contour map below shows level curves of a function <m>f(x,y)</m>.
        The points <m>A</m>, <m>B</m>, and <m>C</m> and the unit vectors
        <m>\bvec{u}</m> and <m>\bvec{v}</m> (based at <m>A</m>) are marked on
        the map.
      </p>
      <!-- FIGURE PLACEHOLDER: replace with an <image> (e.g., a <latex-image>) -->
      <p>
        <alert>[Figure placeholder]</alert> A contour map of <m>f</m> with
        labeled level curves (e.g., <m>10,20,\ldots,60</m>), some regions where
        the curves are close together and others where they are far apart.
        Points <m>A</m>, <m>B</m>, and <m>C</m> are marked.
        At <m>A</m>, unit vector <m>\bvec{u}</m> points roughly toward lower
        values and unit vector <m>\bvec{v}</m> is tangent to the level curve
        through <m>A</m>.
      </p>
    </introduction>

    <task workspace="1.5in">
      <statement>
        <p>
          Sketch <m>\grad f</m> at each of the points <m>A</m>, <m>B</m>, and
          <m>C</m>.
          (Only the direction matters.)
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          At which of the three points is <m>|\grad f|</m> the largest?
          The smallest?
          Explain.
        </p>
      </statement>
    </task>

    <task workspace="1.5in">
      <statement>
        <p>
          Is <m>D_{\bvec{u}}f(A)</m> positive, negative, or zero?
          What about <m>D_{\bvec{v}}f(A)</m>?
        </p>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-tangent-plane-surface" workspace="3in">
    <statement>
      <p>
        Find an equation of the tangent plane to the surface <m>yz=\ln(x+z)</m> at the point <m>(0,0,1)</m>.
      </p>
    </statement>
    <solution>
      <p>
        Define <md>F(x,y,z)=yz-\ln(x+z)</md>. Then the given surface is the level surface <m>F(x,y,z)=0</m>. The gradient of <m>F</m> is
        <md>
        \grad F(x,y,z)=\left\langle -\frac{1}{x+z},\,z,\,y-\frac{1}{x+z} \right\rangle</md>. So, 
        <md>\bvec{n}=\grad F(0,0,1)=\langle -1,\,1,\,-1\rangle</md> is a normal vector to the tangent plane at <m>(0,0,1)</m>. Hence, the tangent plane is
        <md>
          -(x-0)+(y-0)-(z-1)=0
        </md>,
        or equivalently <m>x-y+z=1</m>.
      </p>
    </solution>

  </exercise>


  <exercise xml:id="ex-classify-critical-points" workspace="3in">
    <statement>
      <p>
        Find the locations of any local maxima, local minima, and saddle points of
        <m>f(x,y)=x^3+y^3-3xy</m>.
      </p>
    </statement>
    <solution>
      <p>
        The first partial derivatives are
        <md>
          <mrow>f_x(x,y) \amp = 3x^2-3y</mrow>
          <mrow>f_y(x,y) \amp = 3y^2-3x</mrow>
        </md>.
        Setting <m>f_x(x,y)=0</m> gives <m>y=x^2</m>. Substituting into <m>f_y(x,y)=0</m> gives
        <md>
          x^4-x = x(x^3-1) = 0
        </md>,
        so <m>x=0</m> or <m>x=1</m>. The critical points are <m>(0,0)</m> and <m>(1,1)</m>.
      </p>
      <p>
        The second partial derivatives are
        <md>
          <mrow>f_{xx}(x,y) \amp = 6x</mrow>
          <mrow>f_{xy}(x,y) \amp = -3</mrow>
          <mrow>f_{yy}(x,y) \amp = 6y</mrow>
        </md>,
        so
        <md>
          <mrow>D(x,y) \amp = (6x)(6y)-(-3)^2</mrow>
          <mrow>\amp = 36xy-9</mrow>
        </md>.
      </p>
      <ul>
        <li>
          <p>
            <m>D(0,0)=36(0)(0)-9=-9\lt 0</m>, so <m>(0,0)</m> is a saddle point.
          </p>
        </li>
        <li>
          <p>
            <m>D(1,1)=36(1)(1)-9=27\gt 0</m> and <m>f_{xx}(1,1)=6\gt 0</m>, so <m>(1,1)</m> is a local minimum.
          </p>
        </li>
      </ul>
      <p>
        There are no local maxima.
      </p>
    </solution>
  </exercise>

  <!-- Alternative functions for the problem above (swap one into the statement if desired):
         f(x,y) = 2x^3 + 6xy + 3y^2         critical points (0,0) saddle; (1,-1) local min, f = -1
         f(x,y) = x^4 + y^4 - 4xy + 1       critical points (0,0) saddle; (1,1), (-1,-1) local min, f = -1
         f(x,y) = xy - x^2 y - x y^2        critical points (0,0), (1,0), (0,1) saddles; (1/3,1/3) local max, f = 1/27
  -->

  <exercise xml:id="ex-second-derivative-test">
    <introduction>
      <p>
        Suppose <m>(1,2)</m> is a critical point of a function <m>f</m> with
        continuous second partial derivatives.
        In each case, what can you say about <m>f</m> at <m>(1,2)</m>?
      </p>
    </introduction>

    <task label="sdt-a">
      <statement>
        <p>
          <m>f_{xx}(1,2)=4, \quad f_{xy}(1,2)=3, \quad f_{yy}(1,2)=5</m>
        </p>
      </statement>
      <choices randomize="no">
          <choice>
            <statement><p>Local maximum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p>Local minimum</p></statement>
            <feedback><p>Correct. <m>D=f_{xx}f_{yy}-f_{xy}^2=20-9=11\gt 0</m> and <m>f_{xx}(1,2)=4\gt 0</m>, so <m>f</m> has a local minimum at <m>(1,2)</m>.</p></feedback>
          </choice>
          <choice>
            <statement><p>Saddle point</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>The test is inconclusive</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
      </choices>
    </task>

    <task label="sdt-b">
      <statement>
        <p>
          <m>f_{xx}(1,2)=4, \quad f_{xy}(1,2)=6, \quad f_{yy}(1,2)=5</m>
        </p>
      </statement>
      <choices randomize="no">
          <choice>
            <statement><p>Local maximum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>Local minimum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p>Saddle point</p></statement>
            <feedback><p>Correct. <m>D=f_{xx}f_{yy}-f_{xy}^2=20-36=-16\lt 0</m>, so <m>f</m> has a saddle point at <m>(1,2)</m>.</p></feedback>
          </choice>
          <choice>
            <statement><p>The test is inconclusive</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
      </choices>
    </task>

    <task label="sdt-c">
      <statement>
        <p>
          <m>f_{xx}(1,2)=-2, \quad f_{xy}(1,2)=1, \quad f_{yy}(1,2)=-3</m>
        </p>
      </statement>
      <choices randomize="no">
          <choice correct="yes">
            <statement><p>Local maximum</p></statement>
            <feedback><p>Correct. <m>D=f_{xx}f_{yy}-f_{xy}^2=6-1=5\gt 0</m> and <m>f_{xx}(1,2)=-2\lt 0</m>, so <m>f</m> has a local maximum at <m>(1,2)</m>.</p></feedback>
          </choice>
          <choice>
            <statement><p>Local minimum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>Saddle point</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>The test is inconclusive</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
      </choices>
    </task>

    <task label="sdt-d">
      <statement>
        <p>
          <m>f_{xx}(1,2)=2, \quad f_{xy}(1,2)=4, \quad f_{yy}(1,2)=8</m>
        </p>
      </statement>
      <choices randomize="no">
          <choice>
            <statement><p>Local maximum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>Local minimum</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice>
            <statement><p>Saddle point</p></statement>
            <feedback><p>Not quite. Compute <m>D=f_{xx}f_{yy}-f_{xy}^2</m> and check its sign (and, if needed, the sign of <m>f_{xx}</m>).</p></feedback>
          </choice>
          <choice correct="yes">
            <statement><p>The test is inconclusive</p></statement>
            <feedback><p>Correct. <m>D=f_{xx}f_{yy}-f_{xy}^2=16-16=0</m>, so the Second Derivatives Test gives no information.</p></feedback>
          </choice>
      </choices>
    </task>
  </exercise>


  <exercise xml:id="ex-contour-extrema" workspace="3in">
    <statement>
      <p>
        A contour map of a function <m>f</m> is shown below.
      </p>
      <!-- FIGURE PLACEHOLDER: replace with an <image> (e.g., a <latex-image>) -->
